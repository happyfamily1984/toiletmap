# 4자리 숫자 접속 코드 (기본값 6511)
ACCESS_CODE=6511
# 네이버 클라우드 플랫폼 Maps Application 의 Client ID (필수)
NAVER_MAP_CLIENT_ID=
# 로그인 쿠키 서명용 임의의 긴 문자열 (권장, 없으면 재시작 시 재로그인 필요)
SESSION_SECRET=
# PostgreSQL 접속 주소 (Neon 무료 DB). 없으면 data/toilets.json 파일에 저장
DATABASE_URL=
# 카카오 애드핏 광고 단위 ID (DAN-...). 비워두면 광고 없음
ADFIT_AD_UNIT=
PORT=3000
# 데이터 파일 위치 (기본: ./data/toilets.json)
# DATA_FILE=/app/data/toilets.json
